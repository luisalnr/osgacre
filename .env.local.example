# Neon — projeto dedicado ao OSG
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/osg?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/osg?sslmode=require"

# Assinatura do cookie de sessao do /admin (string aleatoria longa)
SESSION_SECRET="troque-por-uma-string-aleatoria-de-64-caracteres"

# Credenciais criadas por `npm run db:seed-admin`
ADMIN_EMAIL="voce@exemplo.gov.br"
ADMIN_PASSWORD="defina-uma-senha-forte"
ADMIN_NAME="Nome de quem administra"

# Login do /admin enquanto nao ha Neon: a conta vem daqui em vez da tabela
# osg_usuarios. Só tem efeito com NODE_ENV != production E sem DATABASE_URL —
# assim que o banco entra, estas linhas ficam inalcancaveis. Nunca definir no
# Vercel. Gere o hash com `npx tsx scripts/hash-senha.ts "sua senha"`; a senha
# em texto nunca vai para o arquivo.
# ADMIN_LOCAL_EMAIL="admin@osgacre.local"
# ADMIN_LOCAL_SENHA_HASH="salt:hash"
# ADMIN_LOCAL_NOME="Administracao (local)"

# Atalho de desenvolvimento: abre o /admin sem login NENHUM, para inspecionar a
# tela antes de o banco existir. Prefira o login local acima, que ao menos pede
# senha. Só tem efeito com NODE_ENV != production; um build de producao ignora.
# Nunca definir no Vercel.
# ADMIN_DEV_BYPASS=1
